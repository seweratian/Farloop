+/// # Safety
+/// Farloop：给正在运行的实例追加端口转发（不用重启组网，打通的 P2P 不会断）。
+/// spec 每行一条："tcp|udp 绑定地址:端口 目标地址:端口"
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn add_port_forwards(
+    inst_name: *const std::ffi::c_char,
+    spec: *const std::ffi::c_char,
+) -> std::ffi::c_int {
+    use easytier::proto::{
+        api::config::{ConfigPatchAction, InstanceConfigPatch, PatchConfigRequest, PortForwardPatch},
+        common::{PortForwardConfigPb, SocketType},
+        rpc_types::controller::BaseController,
+    };
+    let (name, spec) = unsafe {
+        if inst_name.is_null() || spec.is_null() {
+            set_error_msg("null argument");
+            return -1;
+        }
+        (
+            std::ffi::CStr::from_ptr(inst_name).to_string_lossy().into_owned(),
+            std::ffi::CStr::from_ptr(spec).to_string_lossy().into_owned(),
+        )
+    };
+    let Some(id) = INSTANCE_NAME_ID_MAP.get(&name).map(|v| *v) else {
+        set_error_msg("instance not found");
+        return -1;
+    };
+    let Some(svc) = INSTANCE_MANAGER.get_instance_service(&id) else {
+        set_error_msg("instance service not available");
+        return -1;
+    };
+    let mut forwards = Vec::new();
+    for line in spec.lines() {
+        let p: Vec<&str> = line.split_whitespace().collect();
+        if p.len() != 3 {
+            continue;
+        }
+        let (Ok(bind), Ok(dst)) = (p[1].parse::<std::net::SocketAddr>(), p[2].parse::<std::net::SocketAddr>()) else {
+            continue;
+        };
+        forwards.push(PortForwardPatch {
+            action: ConfigPatchAction::Add as i32,
+            cfg: Some(PortForwardConfigPb {
+                bind_addr: Some(bind.into()),
+                dst_addr: Some(dst.into()),
+                socket_type: if p[0] == "udp" { SocketType::Udp as i32 } else { SocketType::Tcp as i32 },
+            }),
+        });
+    }
+    if forwards.is_empty() {
+        return 0;
+    }
+    let req = PatchConfigRequest {
+        patch: Some(InstanceConfigPatch { port_forwards: forwards, ..Default::default() }),
+        instance: None,
+    };
+    // 新加的转发会在这个运行时上起后台任务（监听、收发），所以它必须一直活着，不能用完就丢
+    static PATCH_RT: once_cell::sync::Lazy<Option<tokio::runtime::Runtime>> = once_cell::sync::Lazy::new(|| {
+        tokio::runtime::Builder::new_multi_thread().worker_threads(2).thread_name("fr-portfwd").enable_all().build().ok()
+    });
+    let Some(rt) = PATCH_RT.as_ref() else {
+        set_error_msg("runtime unavailable");
+        return -1;
+    };
+    match rt.block_on(svc.get_config_service().patch_config(BaseController::default(), req)) {
+        Ok(_) => 0,
+        Err(e) => {
+            set_error_msg(&format!("add port forwards failed: {:?}", e));
+            -1
+        }
+    }
+}
