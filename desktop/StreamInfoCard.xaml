<Window x:Class="FreeRemote.StreamInfoCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="Card" CornerRadius="12" Background="#C81C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1"
            Padding="14,11,16,12" Margin="8" MinWidth="176">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.35"/></Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#34C759" VerticalAlignment="Center"/>
                <TextBlock x:Name="ModeText" Text="P2P 直连" Foreground="White" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"/>
            </StackPanel>
            <Grid Margin="0,8,0,0">
                <Grid.Resources>
                    <Style x:Key="K" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#A0FFFFFF"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Margin" Value="0,2,14,2"/>
                    </Style>
                    <Style x:Key="V" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Setter Property="Grid.Column" Value="1"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource K}" Text="延迟"/>
                <TextBlock Grid.Row="0" Style="{StaticResource V}" x:Name="LatText" Text="—"/>
                <TextBlock Grid.Row="1" Style="{StaticResource K}" Text="码率"/>
                <TextBlock Grid.Row="1" Style="{StaticResource V}" x:Name="RateText" Text="—"/>
                <TextBlock Grid.Row="2" Style="{StaticResource K}" Text="画面"/>
                <TextBlock Grid.Row="2" Style="{StaticResource V}" x:Name="VideoText" Text="—"/>
                <TextBlock Grid.Row="3" Style="{StaticResource K}" Text="编码"/>
                <TextBlock Grid.Row="3" Style="{StaticResource V}" x:Name="CodecText" Text="—"/>
                <TextBlock Grid.Row="4" Style="{StaticResource K}" Text="丢包"/>
                <TextBlock Grid.Row="4" Style="{StaticResource V}" x:Name="LossText" Text="—"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
