                            <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="远程控制" Style="{StaticResource SectionHeader}"/>
