                                <TextBlock Text="被远程（Sunshine）" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,16,0" Height="48">
                                <TextBlock x:Name="MoonlightState" DockPanel.Dock="Right" Style="{StaticResource Body}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="控制别人（Moonlight）" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="64">
                                <CheckBox x:Name="SwPrivacyVirtual" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="PrivacyVirtual_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="“关闭对方屏幕”时熄灭显示器" Style="{StaticResource Body}"/>
                                    <TextBlock Text="远控时改用虚拟屏，实体显示器无信号待机：省电，OLED 不烧屏。在电脑前按 Ctrl+Alt+Shift+F12 可立即恢复" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Content="重新设置串流账号" Margin="16,0" Height="48" Click="ResetSunshine_Click"/>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Content="清除配对记录（下次连接时重新配对）" Margin="16,0" Height="48" Click="ForgetPair_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="远程开机（本机关机后，别的设备可以把它开起来）" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Margin="16,0,16,0" Height="48">
                                <TextBlock x:Name="WakeNic" DockPanel.Dock="Right" Style="{StaticResource Body}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Text="检测中…"/>
                                <TextBlock Text="网卡" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,16,0" Height="48">
                                <TextBlock x:Name="WakeMagic" DockPanel.Dock="Right" Style="{StaticResource Body}" VerticalAlignment="Center" Text="—"/>
                                <TextBlock Text="网卡允许“魔术包”唤醒" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,16,0" Height="52">
                                <TextBlock x:Name="WakeFast" DockPanel.Dock="Right" Style="{StaticResource Body}" VerticalAlignment="Center" Text="—"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows 快速启动" Style="{StaticResource Body}"/>
                                    <TextBlock Text="需要关闭：开着时关机后网卡会断电，收不到开机信号" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,10,16,10">
                                <Button x:Name="WakeEnableBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="一键开启" VerticalAlignment="Center" Click="WakeEnable_Click"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"
                                           Text="还需要在主板 BIOS 里打开“网络唤醒 / Wake on LAN / Power On By PCI-E”（各品牌叫法不同，只需设置一次）。开机信号由同一局域网里另一台开着 Farloop 的设备代发，和路由器品牌无关；建议用网线连接。"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="2,26,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" FontSize="13" Click="CheckUpdates_Click"
                                Content="检查更新" IsEnabled="{Binding CheckingUpdates, Converter={StaticResource Not}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateCheckedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="组件更新" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Label}"/>
                    </DockPanel>
                    <Border Style="{StaticResource Group}">
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
                                        <DockPanel Margin="16,0,14,0" Height="60">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="更新" Padding="16,5" VerticalAlignment="Center" Click="UpdateComponent_Click"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Body}">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding VersionText, Mode=OneWay}" Foreground="{DynamicResource SecondaryText}" FontSize="12.5"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Role}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0"
                               Text="只提示、不自动安装：点“更新”才会更新。Sunshine、Moonlight 通过 winget 更新，EasyTier 从 GitHub 下载；账号、配对、画质参数都会保留。"/>

                    <TextBlock Text="网络" Style="{StaticResource SectionHeader}"/>
