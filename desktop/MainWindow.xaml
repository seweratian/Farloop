                        <StackPanel>
                            <Button Style="{StaticResource Link}" Content="复制邀请码" Margin="16,0" Height="48" Click="CopyInvite_Click"/>
                            <Border Style="{StaticResource RowSep}"/>
                            <StackPanel Margin="16,10">
                                <TextBlock Text="路由器自动端口映射（UPnP）" FontSize="14" Foreground="{DynamicResource Label}"/>
                                <TextBlock Text="{Binding UpnpStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="60">
                                <CheckBox x:Name="SwP2POnly" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="P2POnly_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="仅 P2P" Style="{StaticResource Body}"/>
                                    <TextBlock Text="数据只走直连、不经中转；打洞不成功时会连不上" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <StackPanel Margin="16,10,14,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="保存" Margin="12,0,0,0" Click="SaveIpRule_Click"/>
                                    <TextBlock Text="打洞用的公网 IP" Style="{StaticResource Body}" VerticalAlignment="Center" Width="140"/>
                                    <TextBox x:Name="IpRuleBox" Style="{StaticResource Field}" Padding="10,6" ToolTip="填公网 IP 的前几段，例如 203.0；留空 = 自动"/>
                                </DockPanel>
                                <TextBlock Text="{Binding PublicIpInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <WrapPanel x:Name="IpRuleButtons" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Content="重启组网服务" Margin="16,0" Height="48" Click="RestartNet_Click"/>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Content="打开日志" Margin="16,0" Height="48" Click="OpenLog_Click"/>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Foreground="{DynamicResource Red}" Content="退出网络并重新设置…" Margin="16,0" Height="48" Click="Reset_Click"/>
                            <Border Style="{StaticResource RowSep}"/>
                            <Button Style="{StaticResource Link}" Foreground="{DynamicResource Red}" Content="卸载 Farloop…" Margin="16,0" Height="48" Click="Uninstall_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="中继节点" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel Margin="16,14,16,14">
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="负责帮两台电脑交换地址、协调打洞，打不通时兜底中转。每行一个。两台电脑至少要有一个相同的节点。数据经网络密钥加密，节点看不到内容。"/>
                            <TextBox x:Name="PeersBox" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="13" MinHeight="120" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Style="{StaticResource Link}" Content="恢复默认" Margin="0,0,18,0" Click="ResetPeers_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="保存并重启组网" Click="SavePeers_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Farloop  ·  基于 EasyTier、Sunshine、Moonlight" Style="{StaticResource Caption}" Margin="16,22,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!--提示条 -->
            <Border x:Name="ToastBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                    Background="#EE1D1D1F" CornerRadius="14" Padding="18,12" Visibility="Collapsed" MaxWidth="620">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.2"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="13.5" TextWrapping="Wrap" MaxWidth="480" VerticalAlignment="Center"/>
                    <Button x:Name="ToastOpen" Style="{StaticResource Link}" Foreground="#64D2FF" Content="打开" Margin="16,0,0,0" Click="ToastOpen_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== 首次设置向导（覆盖全窗口） ===================== -->
        <Grid x:Name="SetupOverlay" Grid.ColumnSpan="2" Margin="0,40,0,0" Visibility="Collapsed">
            <Border Background="{DynamicResource ContentLayer}" BorderBrush="{DynamicResource ContentStroke}" BorderThickness="0,1,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Width="540" Margin="0,10,0,40" Padding="36,34" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <!-- 第一步：选择 -->
                        <StackPanel x:Name="SetupForm">
                            <Image Source="{StaticResource Logo}" Width="84" Height="84" HorizontalAlignment="Center"/>
                            <TextBlock Text="欢迎使用 Farloop" Style="{StaticResource LargeTitle}" FontSize="26" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="高帧率远程桌面 · 文件传输 · 剪贴板同步" Style="{StaticResource Caption}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,24"/>

                            <TextBlock Text="设备名称" Style="{StaticResource Caption}" Margin="4,0,0,6"/>
                            <TextBox x:Name="SetupName" Style="{StaticResource Field}"/>

                            <RadioButton x:Name="OptCreate" Style="{StaticResource OptionTile}" GroupName="setup" IsChecked="True" Margin="0,18,0,0" Checked="SetupOpt_Checked">
                                <StackPanel>
                                    <TextBlock Text="创建新网络" Style="{StaticResource Headline}"/>
                                    <TextBlock Text="第一台电脑选这个，完成后把邀请码发给其他电脑" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="OptJoin" Style="{StaticResource OptionTile}" GroupName="setup" Margin="0,10,0,0" Checked="SetupOpt_Checked">
                                <StackPanel>
                                    <TextBlock Text="加入已有网络" Style="{StaticResource Headline}"/>
                                    <TextBlock Text="粘贴另一台电脑上的邀请码" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <TextBox x:Name="InviteBox" Style="{StaticResource Field}" Margin="0,10,0,0" Visibility="Collapsed" ToolTip="FR1-…"/>

                            <Border Background="{DynamicResource FieldBg}" CornerRadius="12" Margin="0,18,0,0">
                                <StackPanel>
                                    <DockPanel Margin="16,0,14,0" Height="56">
                                        <CheckBox x:Name="SetupAllow" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="允许这台电脑被远程" Style="{StaticResource Body}"/>
                                            <TextBlock Text="安装 Sunshine（N 卡 NVENC 硬件编码）" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0,0,0"/>
                                    <DockPanel Margin="16,0,14,0" Height="56">
                                        <CheckBox x:Name="SetupControl" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="用这台电脑控制别人" Style="{StaticResource Body}"/>
                                            <TextBlock Text="安装 Moonlight（低延迟解码）" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="SetupError" Foreground="{DynamicResource Red}" FontSize="13" TextWrapping="Wrap" Margin="4,12,0,0" Visibility="Collapsed"/>
                            <Button Style="{StaticResource Primary}" Content="开始" Margin="0,22,0,0" Padding="18,11" FontSize="15" Click="SetupStart_Click"/>
                        </StackPanel>

                        <!-- 第二步：安装进度 -->
                        <StackPanel x:Name="SetupProgress" Visibility="Collapsed">
                            <TextBlock x:Name="SetupTitle" Text="正在设置…" Style="{StaticResource LargeTitle}" FontSize="24"/>
                            <TextBlock Text="首次安装需要下载组件，大约需要几分钟。" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,6,0,20"/>
                            <ItemsControl x:Name="StepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="InviteResult" Background="{DynamicResource BlueTint}" CornerRadius="12" Padding="16,14" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="邀请码（在其他电脑上粘贴它即可加入，请勿外传）" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="InviteOut" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="SetupDone" Style="{StaticResource Primary}" Content="完成" Margin="0,22,0,0" Padding="18,11" FontSize="15" Click="SetupDone_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
        <!-- 窗口按钮（参考图：主面板右上角的简洁图标） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,26,0">
            <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="最小化"/>
            <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" Content="&#xE922;" Click="Max_Click" ToolTip="最大化"/>
            <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭到托盘"/>
        </StackPanel>
    </Grid>
</Window>
