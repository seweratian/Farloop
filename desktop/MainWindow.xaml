                                <CheckBox x:Name="FileClipSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggles_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="复制粘贴文件" Style="{StaticResource Body}"/>
                                    <TextBlock Text="在一端复制文件，另一端直接 Ctrl+V（2 GB 以内）" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="文件" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Group}">
                        <DockPanel Margin="16,0,16,0" Height="52">
