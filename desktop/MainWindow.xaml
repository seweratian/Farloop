<Window x:Class="FreeRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FreeRemote.Core"
        Title="Farloop" Icon="app.ico" Width="1100" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- 整个窗口铺系统毛玻璃（代码里开启）；窗口按钮自绘成简洁图标，放在主面板右上角 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="-1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 侧边栏 ===================== -->
        <DockPanel Grid.Column="0" Margin="16,22,14,16">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,30">
                    <Image Source="{StaticResource Logo}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Farloop" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
                            <Border Margin="7,2,0,0" Padding="6,1,6,1.5" CornerRadius="6" VerticalAlignment="Center" Background="#1A3D7BF7">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                           Text="{Binding Source={x:Static core:PeerSession.Version}, StringFormat=v{0}}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="远程控制" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="1,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <RadioButton x:Name="NavDevices" Style="{StaticResource NavPill}" Tag="&#xE7F4;" Content="设备" IsChecked="True" GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTransfers" Style="{StaticResource NavPill}" Tag="&#xE896;" Content="传输" GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAssist" Style="{StaticResource NavPill}" Tag="&#xE716;" Content="协助" GroupName="nav" Checked="Nav_Checked"/>
                <Grid>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavPill}" Tag="&#xE713;" Content="设置" GroupName="nav" Checked="Nav_Checked"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                             IsHitTestVisible="False" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                <Button Style="{StaticResource GlassPill}" Padding="14,12" Click="SidebarSend_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="发送文件"/>
                    </StackPanel>
                </Button>
                <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="16" Background="{DynamicResource fr_E6FFFFFF}" BorderBrush="{DynamicResource fr_B3FFFFFF}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                    <DockPanel>
                        <CheckBox x:Name="SwAllowControl" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="AllowControl_Click"/>
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Width="26" Foreground="{DynamicResource fr_B3000000}"/>
                        <TextBlock Text="允许被远程" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="10,18,0,0">
                    <Ellipse x:Name="NetDot" Width="8" Height="8" Fill="{DynamicResource Tertiary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NetStatus}" FontSize="12.5" Margin="8,0,0,0" Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding MyIp, StringFormat=本机 {0}}" Style="{StaticResource Caption}" Margin="26,2,0,0"/>
                <Button Style="{StaticResource Link}" Foreground="{DynamicResource fr_B3000000}" Margin="10,18,0,0" Click="Help_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource Icons}" FontSize="15" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="帮助" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Link}" Foreground="{DynamicResource fr_B3000000}" Margin="10,14,0,0" Click="Exit_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="15" Width="26" VerticalAlignment="Center"/>
                        <TextBlock Text="退出" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ===================== 主面板：一整块大圆角毛玻璃 ===================== -->
        <Border Grid.Column="1" Margin="0,12,12,12" CornerRadius="22" Background="{DynamicResource PanelGlass}"
                BorderBrush="{DynamicResource fr_CCFFFFFF}" BorderThickness="1" Effect="{StaticResource SoftShadow}"/>
        <Grid Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--设备页 -->
            <ScrollViewer x:Name="PageDevices" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,26,34,20">
                    <Grid Margin="0,0,130,0">
                        <StackPanel>
                            <TextBlock Text="设备" Style="{StaticResource LargeTitle}"/>
                            <TextBlock Text="同一网络里的电脑会自动出现在这里，把文件拖到卡片上即可发送" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource GlassPill}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CopyInvite_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="复制邀请码"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 正在远程的横幅 -->
                    <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="14" Background="#263D7BF7"
                            Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AF;" Foreground="{DynamicResource Accent}" FontSize="15"/>
                            <TextBlock Text="{Binding Banner}" Margin="10,0,0,0" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 多条宽带提示（一级页面直接选好推荐线路） -->
                    <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="14" Background="#263D7BF7"
                            Visibility="{Binding HasNetTip, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" Foreground="{DynamicResource Accent}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding NetTip}" Margin="10,0,12,0" FontSize="13.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="使用推荐" Style="{StaticResource CardAction}" Click="UseSuggestedRule_Click" Margin="0,0,8,0"/>
                                <Button Content="不用了" Style="{StaticResource CardActionGlass}" Click="DismissNetTip_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 本机 -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{StaticResource Logo}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MyName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Label}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                    <Run Text="本机  ·  "/><Run Text="{Binding MyIp, Mode=OneWay}" FontFamily="Consolas"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="我的设备" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Label}" Margin="2,28,0,14"/>

                    <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" FontSize="13.5" TextWrapping="Wrap" Margin="2,0,0,0"
                               Text="还没有其他设备。在另一台电脑上运行 Farloop，选择“加入已有网络”，粘贴本机的邀请码即可。"/>

                    <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="296" Margin="0,0,18,18" CornerRadius="20" Background="{Binding CardBrush}"
                                        BorderBrush="{DynamicResource fr_CCFFFFFF}" BorderThickness="1" Effect="{StaticResource CardShadow}" AllowDrop="True"
                                        Drop="Device_Drop" DragEnter="Device_DragEnter" DragLeave="Device_DragLeave">
                                    <StackPanel Margin="20,18,20,14">
                                        <Grid>
                                            <Border Width="40" Height="40" CornerRadius="11" Background="{Binding BadgeBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding IconGlyph}" FontSize="18" Foreground="{Binding IconBrush}"/>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" Margin="5,0,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BigMetric}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,2,0,0" Foreground="{DynamicResource Label}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Label}"/>
                                        <TextBlock Text="{Binding Ip}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource SecondaryText}" Margin="1,4,0,0"/>
                                        <TextBlock Text="{Binding Busy}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" Margin="1,8,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                        <Border Height="1" Background="{DynamicResource fr_14000000}" Margin="0,14,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource CardAction}" Content="连接" Click="Connect_Click" Margin="0,0,8,0"
                                                    Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource CardActionDanger}" Content="断开" Click="Disconnect_Click" Margin="0,0,8,0"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource CardActionGlass}" Content="发送文件" Click="SendFiles_Click"
                                                    Visibility="{Binding ShowSendFiles, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource CardActionGlass}" Content="详情" Click="More_Click" Margin="8,0,0,0" ToolTip="设备参数、快速启动、终端"
                                                    Visibility="{Binding ShowSendFiles, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource CardAction}" Click="Wake_Click"
                                                    Visibility="{Binding ShowWake, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="远程开机"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource CardActionGlass}" Content="移除" Click="RemoveDevice_Click" Margin="8,0,0,0"
                                                    ToolTip="从列表里删掉这台离线的设备（它再上线时会自动回来）"
                                                    Visibility="{Binding ShowRemove, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部实时状态条（参考图的上行/下行/CPU/内存/服务状态） -->
            <Border Grid.Row="1" Margin="34,0,34,16" Padding="0,12,0,0" BorderBrush="{DynamicResource fr_14000000}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UpText}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="实时上行流量" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Label}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding UpFrac, Mode=OneWay}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DownText}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="实时下行流量" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Label}"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding DownFrac, Mode=OneWay}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPU 负载" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding CpuFrac, Mode=OneWay}" Width="46" Height="8" Margin="8,0,8,0"/>
                        <TextBlock Text="{Binding CpuText}" FontSize="11" VerticalAlignment="Center" Width="30" Foreground="{DynamicResource Label}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="内存占用" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding MemFrac, Mode=OneWay}" Width="46" Height="8" Margin="8,0,8,0"/>
                        <TextBlock Text="{Binding MemText}" FontSize="11" VerticalAlignment="Center" Width="30" Foreground="{DynamicResource Label}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding ServiceBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ServiceText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{Binding ServiceBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--传输页 -->
            <ScrollViewer x:Name="PageTransfers" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="40,40,40,40">
                    <Grid>
                        <TextBlock Text="传输" Style="{StaticResource LargeTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Link}" Content="清除已完成" Margin="0,0,18,0" Click="ClearTransfers_Click"/>
                            <Button Style="{StaticResource Secondary}" Content="打开接收文件夹" Click="OpenReceive_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TransfersEmpty" Text="还没有传输记录。复制粘贴、拖放文件都会显示在这里。" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,8,0,0"/>

                    <Border Style="{StaticResource Group}" Margin="0,22,0,0" x:Name="TransfersGroup">
                        <ItemsControl ItemsSource="{Binding Transfers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,14,18,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource FieldBg}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource Blue}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Headline}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,6"/>
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" FontSize="12"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Link}" Content="显示" Click="ShowTransfer_Click" VerticalAlignment="Center"
                                                Visibility="{Binding Finished, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 远程协助：设备码 + 临时密码（像 UU 远程） -->
            <ScrollViewer x:Name="PageAssist" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="40,40,40,40" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="远程协助" Style="{StaticResource LargeTitle}"/>
                    <TextBlock Text="不在同一个组网的电脑，凭设备码和临时密码就能互相协助，像 UU 远程、向日葵那样。双方都要装 Farloop。"
                               Style="{StaticResource Caption}" FontSize="13.5" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="让别人协助我" Style="{StaticResource SectionHeader}" Margin="4,26,0,8"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Margin="16,0,14,0" Height="56">
                                <CheckBox x:Name="SwAssist" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="AssistEnabled_Click"/>
                                <TextBlock Text="允许别人用设备码和密码协助我" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <Grid Margin="20,18,20,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="本机设备码" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding AssistIdText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Label}" Margin="0,4,0,0"/>
                                    <Button Style="{StaticResource Link}" Content="复制设备码和密码" HorizontalAlignment="Left" Margin="0,6,0,0" Click="AssistCopy_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="临时密码（每次协助结束自动更换）" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding AssistPassword}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Label}" Margin="0,4,0,0" FontFamily="Consolas"/>
                                    <Button Style="{StaticResource Link}" Content="换一个密码" HorizontalAlignment="Left" Margin="0,6,0,0" Click="AssistRefresh_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding AssistStatus}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="20,8,20,16"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,20,18">
                                <Button x:Name="AssistPrepareBtn" Style="{StaticResource Secondary}" Content="开启“允许被远程”" Margin="0,0,12,0" Click="AssistPrepare_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="断开所有协助者" Click="AssistDisconnect_Click"
                                        Visibility="{Binding AssistBeingHelped, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="有人请求协助时会弹窗让你确认，点“允许”后才能控制。对方能看到并操作屏幕、互传剪贴板和文件，但不能用终端、浏览文件或启动程序。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,8,0,0"/>

                    <TextBlock Text="协助别人" Style="{StaticResource SectionHeader}" Margin="4,30,0,8"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel Margin="20,18,20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="对方的设备码" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="AssistIdBox" Style="{StaticResource Field}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="对方的临时密码" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="AssistPwBox" Style="{StaticResource Field}" FontSize="16" FontFamily="Consolas" KeyDown="AssistPw_KeyDown"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="AssistConnectBtn" Style="{StaticResource Primary}" Content="连接" Padding="26,9" Click="AssistConnect_Click"/>
                                <Button Style="{StaticResource Secondary}" Content="结束协助" Margin="12,0,0,0" Click="AssistEnd_Click"
                                        Visibility="{Binding AssistHelping, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AssistHelpStatus}" Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--设置页（iOS 分组列表风格） -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="40,40,40,40" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="设置" Style="{StaticResource LargeTitle}"/>

                    <TextBlock Text="本机" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Margin="16,0,12,0" Height="52">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}"><StackPanel x:Name="SegTheme" Orientation="Horizontal"/></Border>
                                <TextBlock Text="外观" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,8,12,8" MinHeight="36">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="保存" Margin="12,0,0,0" Click="SaveName_Click"/>
                                <TextBlock Text="设备名称" Style="{StaticResource Body}" VerticalAlignment="Center" Width="140"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource Field}" Padding="10,6"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,16,0" Height="48">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MyIp}" Style="{StaticResource Body}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="虚拟 IP" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="56">
                                <CheckBox x:Name="SwAutostart" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Autostart_Click"/>
                                <StackPanel VerticalAlignment="Center">
