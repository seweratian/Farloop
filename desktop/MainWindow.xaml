                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="52">
                                <CheckBox x:Name="SwAudioHost" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="StreamToggle_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="声音在被控端播放" Style="{StaticResource Body}"/>
