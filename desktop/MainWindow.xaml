                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="52">
                                <CheckBox x:Name="SwCard" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="StreamToggle_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="信息卡片" Style="{StaticResource Body}"/>
                                    <TextBlock Text="画面左上角显示连接方式、延迟、码率" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="52">
                                <CheckBox x:Name="SwPerf" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="StreamToggle_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="详细性能统计" Style="{StaticResource Body}"/>
                                    <TextBlock Text="Moonlight 自带：解码帧率、解码耗时、网络抖动" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="16,8,16,0"
                               Text="改动在下次连接时生效。远程中快捷键：Ctrl+Alt+Shift+X 切换全屏/窗口 · Ctrl+Alt+Shift+Z 释放鼠标 · Ctrl+Alt+Shift+S 详细统计 · Ctrl+Alt+Shift+Q 结束远程"/>

                    <TextBlock Text="剪贴板" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Group}">
                        <StackPanel>
                            <DockPanel Margin="16,0,14,0" Height="52">
                                <CheckBox x:Name="ClipSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Toggles_Click"/>
