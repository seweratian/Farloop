                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource RowSep}"/>
                            <DockPanel Margin="16,0,14,0" Height="52">
                                <CheckBox x:Name="SwMouse" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="StreamToggle_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="桌面鼠标模式" Style="{StaticResource Body}"/>
