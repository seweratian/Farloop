<Window x:Class="FreeRemote.ControlCenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 深色分段控件 -->
        <Style x:Key="SegBarDark" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="SegDark" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E5FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="4" Padding="4,4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="#60CDFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色开关 -->
        <Style x:Key="SwitchDark" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20">
                            <Border x:Name="track" CornerRadius="10" Background="Transparent" BorderBrush="#C8FFFFFF" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="#E0FFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="tx" X="0"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#60CDFF"/><Setter TargetName="track" Property="BorderBrush" Value="#60CDFF"/><Setter TargetName="knob" Property="Fill" Value="#000000"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色按钮 -->
        <Style x:Key="DarkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="2,12,0,5"/>
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel HorizontalAlignment="Right" Margin="6,0,6,10">
        <!-- 收起状态：标题栏上的小药丸按钮 -->
        <Border x:Name="Pill" HorizontalAlignment="Right" Height="24" CornerRadius="6" Background="#F02C2C2C"
                BorderBrush="#33FFFFFF" BorderThickness="1" Padding="9,0,11,0" Cursor="Hand" MouseLeftButtonUp="Pill_Click">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="#6CCB5F" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White" Margin="7,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="控制中心" Foreground="White" FontSize="12" Margin="5,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 展开面板 -->
        <Border x:Name="Panel" Visibility="Collapsed" Width="316" Margin="0,8,0,0" CornerRadius="8"
                Background="#F72C2C2C" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="16,14,16,16"
                MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45"/></Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="StatusText" Text="P2P 直连" Foreground="#6CCB5F" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="家里电脑" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </DockPanel>

                <TextBlock Text="分辨率" Style="{StaticResource Lbl}"/>
                <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegRes" Rows="1"/></Border>
                <TextBlock Text="帧率" Style="{StaticResource Lbl}"/>
                <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegFps" Rows="1"/></Border>
                <TextBlock Text="码率" Style="{StaticResource Lbl}"/>
                <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegBitrate" Rows="1"/></Border>
                <TextBlock Text="编码" Style="{StaticResource Lbl}"/>
                <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegCodec" Rows="1"/></Border>
                <!-- 被控端有多块屏幕时才显示：切换后对方重启 Sunshine，画面自动重连（约 5 秒） -->
                <StackPanel x:Name="DisplayRow" Visibility="Collapsed">
                    <TextBlock Text="被控端屏幕" Style="{StaticResource Lbl}"/>
                    <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegDisplay" Rows="1"/></Border>
                </StackPanel>
                <!-- 组网方式：仅中转 = 本机 EasyTier 不建立 P2P，所有流量走中转节点（P2P 不稳定时的备用） -->
                <TextBlock Text="连接方式" Style="{StaticResource Lbl}"/>
                <Border Style="{StaticResource SegBarDark}"><UniformGrid x:Name="SegRoute" Rows="1"/></Border>

                <Border Background="#0DFFFFFF" CornerRadius="6" Margin="0,14,0,0" Padding="12,4">
                    <StackPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwPrivacy" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Privacy_Click"/>
                            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="关闭被控端屏幕" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwLocalCursor" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="LocalCursor_Click"/>
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="本地鼠标（零延迟）" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwCard" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Card_Click"/>
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="信息卡片" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwPerf" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Perf_Click"/>
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="详细性能统计" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <Border Height="1" Background="#14FFFFFF" Margin="0,4"/>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwVsync" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Toggles_Click"/>
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="垂直同步（防撕裂）" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwPacing" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Toggles_Click"/>
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="帧调度（更平滑）" Style="{StaticResource RowText}"/>
                        </DockPanel>
                        <DockPanel Height="36">
                            <CheckBox x:Name="SwHdr" DockPanel.Dock="Right" Style="{StaticResource SwitchDark}" VerticalAlignment="Center" Click="Toggles_Click"/>
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="13" VerticalAlignment="Center" Width="22"/>
                            <TextBlock Text="HDR" Style="{StaticResource RowText}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 有需要重连的改动时出现 -->
                <Border x:Name="ApplyBar" Visibility="Collapsed" Background="#1F60CDFF" BorderBrush="#5560CDFF" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DarkBtn}" Background="#60CDFF" Foreground="Black" Content="立即应用" Click="Apply_Click"/>
                        <TextBlock Text="画面参数已改，需快速重连（约 2 秒）" Foreground="#E5FFFFFF" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>
                </Border>

                <UniformGrid Rows="1" Margin="0,12,0,0">
                    <Button Style="{StaticResource DarkBtn}" Margin="0,0,5,0" Click="Fullscreen_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="全屏 / 窗口"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DarkBtn}" Background="#40C42B1C" Foreground="#FF99A4" Margin="5,0,0,0" Click="Disconnect_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="结束远程"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
