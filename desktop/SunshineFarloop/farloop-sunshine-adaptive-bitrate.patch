+    void set_bitrate(int kbps) override {
+      auto ctx = avcodec_ctx.get();
+      if (!ctx || kbps <= 0) {
+        return;
+      }
+      if (initial_max_rate == 0) {
+        initial_max_rate = ctx->rc_max_rate;
+        initial_bit_rate = ctx->bit_rate;
+        initial_min_rate = ctx->rc_min_rate;
+        initial_buffer_size = ctx->rc_buffer_size;
+      }
+      if (initial_max_rate <= 0) {
+        return;
+      }
+      double r = std::clamp((double) kbps * 1000.0 / (double) initial_max_rate, 0.02, 1.0);
+      ctx->rc_max_rate = (int64_t) (initial_max_rate * r);
+      ctx->bit_rate = (int64_t) (initial_bit_rate * r);
+      if (initial_min_rate > 0) {
+        ctx->rc_min_rate = (int64_t) (initial_min_rate * r);
+      }
+      if (initial_buffer_size > 0) {
+        ctx->rc_buffer_size = (int) (initial_buffer_size * r);
+      }
+      BOOST_LOG(debug) << "Farloop: avcodec bitrate -> "sv << ctx->bit_rate;
