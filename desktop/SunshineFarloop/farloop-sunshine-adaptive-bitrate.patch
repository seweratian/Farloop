+    if (!encoder || farloop_initial_kbps == 0) {
+      return false;
+    }
+    kbps = std::clamp<std::uint32_t>(kbps, 300, farloop_initial_kbps);
+    if (kbps == farloop_current_kbps) {
+      return true;
+    }
+
+    farloop_enc_config.rcParams.averageBitRate = kbps * 1000;
+    if (farloop_custom_vbv) {
+      auto vbv = kbps * 1000 / farloop_framerate;
+      if (farloop_vbv_increase > 0) {
+        vbv += vbv * farloop_vbv_increase / 100;
+      }
+      farloop_enc_config.rcParams.vbvBufferSize = vbv;
+    }
+
+    NV_ENC_RECONFIGURE_PARAMS params = {.version = NV_ENC_RECONFIGURE_PARAMS_VER};
+    params.reInitEncodeParams = farloop_init_params;
+    params.reInitEncodeParams.encodeConfig = &farloop_enc_config;
+    params.resetEncoder = 0;
+    params.forceIDR = 0;
+    if (nvenc_failed(nvenc->nvEncReconfigureEncoder(encoder, &params))) {
+      BOOST_LOG(error) << "NvEnc: NvEncReconfigureEncoder() to " << kbps << " kbps failed: " << last_nvenc_error_string;
+      return false;
+    }
+    BOOST_LOG(info) << "NvEnc: bitrate " << farloop_current_kbps << " -> " << kbps << " kbps (Farloop adaptive)";
+    farloop_current_kbps = kbps;
+    return true;
+  }
