<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Windows 11 Fluent + 毛玻璃 ==========
         窗口本体用系统 Acrylic 背景（DWM 实时模糊），这里的颜色大多带透明度，叠在玻璃上 -->
    <!-- 深色模式：这些颜色在切换外观时由 ThemeManager 原地改色（自动生成） -->
    <SolidColorBrush x:Key="fr_08000000" Color="#08000000"/>
    <SolidColorBrush x:Key="fr_0C000000" Color="#0C000000"/>
    <SolidColorBrush x:Key="fr_14000000" Color="#14000000"/>
    <SolidColorBrush x:Key="fr_1AFFFFFF" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="fr_59FFFFFF" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="fr_5C000000" Color="#5C000000"/>
    <SolidColorBrush x:Key="fr_72000000" Color="#72000000"/>
    <SolidColorBrush x:Key="fr_80FFFFFF" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="fr_99FFFFFF" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="fr_9A000000" Color="#9A000000"/>
    <SolidColorBrush x:Key="fr_B3000000" Color="#B3000000"/>
    <SolidColorBrush x:Key="fr_B3FFFFFF" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="fr_C8000000" Color="#C8000000"/>
    <SolidColorBrush x:Key="fr_CCFFFFFF" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="fr_D9000000" Color="#D9000000"/>
    <SolidColorBrush x:Key="fr_E6000000" Color="#E6000000"/>
    <SolidColorBrush x:Key="fr_E6FFFFFF" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="fr_FFFFFFFF" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>                <!-- 不支持毛玻璃时的纯色兜底 -->
    <SolidColorBrush x:Key="SidebarBg" Color="Transparent"/>
    <SolidColorBrush x:Key="ContentLayer" Color="#A6FAFAFA"/>     <!-- 右侧内容区：更亮的一层玻璃 -->
    <SolidColorBrush x:Key="ContentStroke" Color="#14000000"/>
    <SolidColorBrush x:Key="CardBg" Color="#C8FFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#12000000"/>
    <SolidColorBrush x:Key="Label" Color="#E4000000"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#9E000000"/>
    <SolidColorBrush x:Key="Tertiary" Color="#72000000"/>
    <SolidColorBrush x:Key="Separator" Color="#0F000000"/>
    <SolidColorBrush x:Key="Fill" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="FieldBg" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFill" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleFillHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="Blue" Color="#3D7BF7"/>                <!-- 参考图的亮蓝强调色 -->
    <SolidColorBrush x:Key="BlueTint" Color="#26005FB8"/>
    <SolidColorBrush x:Key="Green" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Red" Color="#C42B1C"/>
    <LinearGradientBrush x:Key="AppIconBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4CC2FF" Offset="0"/>
        <GradientStop Color="#005FB8" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.05" Color="#000000"/>

    <!-- ========== 文字（Windows 11 字阶） ========== -->
    <Style x:Key="LargeTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>
    <Style x:Key="Title3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>
    <Style x:Key="Headline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
        <Setter Property="Margin" Value="2,26,0,8"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ========== 玻璃卡片 ========== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource fr_99FFFFFF}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource fr_CCFFFFFF}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource fr_99FFFFFF}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- ========== 按钮（Windows 11：圆角 6） ========== -->
    <Style x:Key="PillBase" TargetType="Button">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{DynamicResource Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource fr_1AFFFFFF}"/>
    </Style>
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{DynamicResource fr_E6FFFFFF}"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>
    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource PillBase}">
        <Setter Property="Background" Value="{DynamicResource Red}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource fr_1AFFFFFF}"/>
    </Style>
    <Style x:Key="Link" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 整行都能点（以前只有文字本身能点） -->
                    <Border Background="Transparent">
                        <ContentPresenter x:Name="c" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Opacity" Value="0.75"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 导航（Windows 11：选中项左侧强调色小竖条） ========== -->
    <Style x:Key="SidebarItem" TargetType="RadioButton">
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="b" CornerRadius="5" Padding="12,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="16"
                                           Foreground="{DynamicResource Label}" Width="24" VerticalAlignment="Center"/>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ind" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Blue}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleFill}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SubtleFillHover}"/>
                            <Setter TargetName="ind" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Windows 11 开关 ========== -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20">
                        <Border x:Name="track" CornerRadius="10" Background="{DynamicResource fr_08000000}" BorderBrush="{DynamicResource fr_9A000000}" BorderThickness="1"/>
                        <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource fr_C8000000}" HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="tx" X="0"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Blue}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 输入框（Windows 11：聚焦时底部强调色线） ========== -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="b" Background="{DynamicResource FieldBg}" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,5,5" Background="{DynamicResource fr_72000000}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource fr_FFFFFFFF}"/>
                            <Setter TargetName="line" Property="Height" Value="2"/>
                            <Setter TargetName="line" Property="Background" Value="{DynamicResource Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 进度条 ========== -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource fr_14000000}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 选项卡片（设置向导） ========== -->
    <Style x:Key="OptionTile" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="8" Padding="16,13" Background="{DynamicResource FieldBg}" BorderThickness="1" BorderBrush="{DynamicResource CardStroke}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource fr_E6FFFFFF}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource fr_FFFFFFFF}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowSep" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Separator}"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- ========== 分段控件（玻璃质感） ========== -->
    <Style x:Key="SegmentBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource fr_0C000000}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Label}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="4" Padding="12,5" Background="Transparent" MinWidth="44" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource fr_80FFFFFF}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource fr_FFFFFFFF}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 细滚动条 ========== -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" Background="{DynamicResource fr_5C000000}" CornerRadius="2" Width="3" Margin="0,4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="Width" Value="6"/>
                                                    <Setter TargetName="t" Property="CornerRadius" Value="3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 参考图风格：大圆角毛玻璃面板、白色胶囊导航、玻璃胶囊按钮 ================= -->
    <SolidColorBrush x:Key="Accent" Color="#3D7BF7"/>
    <LinearGradientBrush x:Key="PanelGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9FFFFFF" Offset="0"/>
        <GradientStop Color="#B8FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.08" Color="#000000"/>

    <Style x:Key="NavPill" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource fr_D9000000}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="14" Padding="16,11" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="i" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="17" Width="28" VerticalAlignment="Center" Foreground="{DynamicResource fr_B3000000}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource fr_59FFFFFF}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource fr_E6FFFFFF}"/>
                            <Setter TargetName="b" Property="Effect" Value="{StaticResource SoftShadow}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="i" Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 玻璃胶囊按钮（侧边栏“发送文件”、页面右上角操作） -->
    <Style x:Key="GlassPill" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource fr_E6000000}"/>
        <Setter Property="Background" Value="{DynamicResource fr_E6FFFFFF}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource fr_B3FFFFFF}" BorderThickness="1" Effect="{StaticResource SoftShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource fr_FFFFFFFF}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片里的小按钮 -->
    <Style x:Key="CardAction" TargetType="Button">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CardActionGlass" TargetType="Button" BasedOn="{StaticResource CardAction}">
        <Setter Property="Foreground" Value="{DynamicResource fr_D9000000}"/>
        <Setter Property="Background" Value="{DynamicResource fr_B3FFFFFF}"/>
    </Style>
    <Style x:Key="CardActionDanger" TargetType="Button" BasedOn="{StaticResource CardAction}">
        <Setter Property="Background" Value="#E5484D"/>
    </Style>

    <!-- 窗口按钮：最小化 / 最大化 / 关闭（简洁图标） -->
    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource fr_B3000000}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource fr_14000000}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 底部状态条里的细进度 -->
